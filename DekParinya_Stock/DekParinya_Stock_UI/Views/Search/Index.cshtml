@model List<SearchResultItem>
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Search";
    var q = ViewBag.Query as string ?? "";
    var grouped = Model.GroupBy(r => r.Type).ToList();

    IHtmlContent Mark(string? text)
    {
        if (string.IsNullOrEmpty(text)) return HtmlString.Empty;
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        if (string.IsNullOrWhiteSpace(q)) return new HtmlString(encoded);
        var pattern = Regex.Escape(System.Net.WebUtility.HtmlEncode(q.Trim()));
        return new HtmlString(Regex.Replace(encoded, pattern, m => "<mark>" + m.Value + "</mark>", RegexOptions.IgnoreCase));
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Search</h1>
        <p class="page-subtitle">
            @if (string.IsNullOrWhiteSpace(q)) { <span>พิมพ์คำค้นหาเพื่อค้นหาทั้งระบบ (กด Ctrl+K)</span> }
            else { <span>พบ @Model.Count รายการ สำหรับ “@q”</span> }
        </p>
    </div>
</div>

<div class="card filter-bar mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label" for="q">Keyword</label>
                <input type="text" class="form-control" id="q" name="q" value="@q" placeholder="สินค้า / เลขที่เอกสาร / ผู้ใช้ / เมนู" autofocus />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-search w-100"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(q) && !Model.Any())
{
    <div class="card"><div class="empty-state"><i class="bi bi-search"></i>ไม่พบผลลัพธ์ ลองใช้คำค้นอื่น</div></div>
}

<div class="row g-3">
    @foreach (var grp in grouped)
    {
        <div class="col-lg-6">
            <div class="card table-card h-100">
                <div class="card-header">
                    <div class="search-group-title"><i class="bi @grp.First().Icon text-accent"></i>@grp.Key <span class="text-muted fw-normal">(@grp.Count())</span></div>
                </div>
                <div>
                    @foreach (var item in grp)
                    {
                        <a class="search-hit" href="@item.Url">
                            <span class="stat-icon blue" style="width:36px;height:36px;font-size:1rem"><i class="bi @item.Icon"></i></span>
                            <span class="min-w-0">
                                <span class="d-block fw-medium">@Mark(item.Title)</span>
                                <span class="d-block small text-muted text-truncate">@Mark(item.Subtitle)</span>
                            </span>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

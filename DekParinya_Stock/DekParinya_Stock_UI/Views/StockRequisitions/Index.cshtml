@model List<StockRequisition>
@{
    ViewData["Title"] = "Stock Requisition";
    var keyword = ViewBag.Keyword as string;
    var status = ViewBag.Status as DocStatus?;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
}

<div class="page-header">
    <div>
        <nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a>&nbsp;/&nbsp;Stock Requisition</nav>
        <h1 class="page-title">Stock Requisition</h1>
        <p class="page-subtitle">รายการใบเบิกสินค้า</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add a Requisition</a>
</div>

<div class="card filter-bar mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label" for="keyword">Keyword</label>
                <input type="text" class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="เลขที่เอกสาร / ผู้ขอเบิก / Event / แผนก" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label" for="status">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<DocStatus>())
                    {
                        <option value="@s" selected="@(status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label" for="from">From</label>
                <input type="date" class="form-control" id="from" name="from" value="@Ui.Iso(from)" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label" for="to">To</label>
                <input type="date" class="form-control" id="to" name="to" value="@Ui.Iso(to)" />
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-search flex-grow-1"><i class="bi bi-search"></i> Search</button>
                <a class="btn btn-outline-dark-grey" asp-action="Index" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="card-header"><h2 class="card-title-sm">Requisitions <span class="text-muted fw-normal">(@Model.Count)</span></h2></div>
    <div class="table-responsive">
        <table class="table table-app table-hover">
            <thead>
                <tr><th>Doc No.</th><th>Request Date</th><th>Requester</th><th>Department</th><th>Event</th><th class="text-end">Items</th><th class="text-end">Total Qty</th><th>Status</th><th class="text-end"></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><a class="doc-link" asp-action="Details" asp-route-id="@r.Id">@r.DocNo</a></td>
                        <td>@Ui.Date(r.RequestDate)</td>
                        <td>@r.Requester</td>
                        <td class="text-muted">@r.Department</td>
                        <td class="text-truncate" style="max-width:240px" title="@r.Event">@r.Event</td>
                        <td class="text-end">@r.Lines.Count</td>
                        <td class="text-end fw-semibold">@Ui.Num(r.TotalQty)</td>
                        <td>@Ui.StatusBadge(r.Status)</td>
                        <td class="text-end"><a class="btn btn-outline-dark-grey btn-icon" asp-action="Details" asp-route-id="@r.Id" title="View"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="empty-state"><i class="bi bi-inbox"></i>ไม่พบข้อมูล</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

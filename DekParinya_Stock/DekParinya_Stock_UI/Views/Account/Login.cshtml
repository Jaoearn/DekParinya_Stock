@model LoginViewModel
@{
    Layout = null;
    var errorText = string.Join(" ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage));
}
<!DOCTYPE html>
<html lang="th" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login · DekParinya Stock</title>
    <link rel="icon" href="~/logo/logo1.jpg" type="image/jpeg" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-body">
    <button class="theme-fab" type="button" data-theme-toggle aria-label="Toggle theme"><i class="bi bi-moon-stars"></i></button>

    <div class="scene">
        <div class="sky" aria-hidden="true">
            <span class="sun"></span>
            <span class="cloud c1"></span><span class="cloud c2"></span><span class="cloud c3"></span>
        </div>

        <div class="shop" id="shop">
            <!-- ===== Awning ===== -->
            <div class="awning" aria-hidden="true"><div class="awning-scallop"></div></div>

            <div class="shop-body">
                <!-- ===== Brand (แทนตำแหน่งตู้กด) ===== -->
                <section class="brand-panel">
                    <img src="~/logo/logo1.jpg" alt="ดินเด็กปริญญา" class="brand-logo-img" asp-append-version="true" />
                    <div class="brand-name">dekparinya</div>
                    <div class="brand-sub">SOIL · FERTILIZER · GARDEN</div>
                    <div class="brand-th">ร้านปุ๋ย · ดินปลูก · วัสดุเกษตร</div>
                </section>

                <!-- ===== Counter / cashier panel ===== -->
                <aside class="counter">
                    <div class="counter-head">
                        <div class="counter-title">ยินดีต้อนรับ</div>
                        <div class="counter-sub">เข้าสู่ระบบ DekParinya Stock</div>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post" class="login-form" id="loginForm"
                          novalidate data-error="@errorText">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" name="ui" value="@ViewData["LoginUi"]" />
                        <div class="member-card-title"><i class="bi bi-person-badge"></i> MEMBER LOGIN</div>

                        <label class="lf-label" for="Email">Email <span class="req">*</span></label>
                        <div class="lf-input">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" type="email" placeholder="name@dekparinya.com" autocomplete="username" required maxlength="200" data-no-counter />
                        </div>

                        <label class="lf-label" for="Password">Password <span class="req">*</span></label>
                        <div class="lf-input">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" required maxlength="200" data-no-counter />
                            <button type="button" class="pw-eye" id="pwToggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>

                        <label class="lf-check">
                            <input asp-for="RememberMe" type="checkbox" /> <span>จดจำการเข้าสู่ระบบ</span>
                        </label>

                        <button type="submit" class="btn-login" id="btnLogin">
                            <i class="bi bi-box-arrow-in-right"></i> LOGIN
                        </button>
                    </form>
                </aside>
            </div>

            <div class="shop-base" aria-hidden="true">
                <span class="pot p1"><i></i></span>
                <span class="pot p2"><i></i></span>
                <span class="base-tag">OPEN 08:00 – 18:00</span>
                <span class="pot p3"><i></i></span>
            </div>
        </div>

        <div class="ground" aria-hidden="true">
            @for (var i = 0; i < 14; i++)
            {
                <span class="sprout" style="--x:@(i * 7 + 2)%; --h:@(10 + (i * 37 % 14))px; --d:@(i % 5 * 0.4)s"></span>
            }
        </div>
        <p class="foot-note">DekParinya Stock · UI Prototype</p>
    </div>

    <div class="fx-layer" id="fxLayer" aria-hidden="true"></div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>

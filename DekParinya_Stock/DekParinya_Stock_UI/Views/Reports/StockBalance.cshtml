@model List<StockBalanceRow>
@inject IDataStore Store
@{
    ViewData["Title"] = "Stock Balance";
    var keyword = ViewBag.Keyword as string;
    var groupId = ViewBag.GroupId as int?;
    var stock = ViewBag.Stock as string;
    var groups = Store.GetGroups();
}

<div class="page-header">
    <div>
        <nav class="breadcrumb no-print"><a asp-controller="Home" asp-action="Index">Dashboard</a>&nbsp;/&nbsp;Report</nav>
        <h1 class="page-title">Stock Balance</h1>
        <p class="page-subtitle">รายงานยอดคงเหลือสินค้า ณ วันที่ @Ui.DateTime(DateTime.Now)</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button type="button" class="btn btn-outline-dark-grey" data-print><i class="bi bi-printer me-1"></i>Print</button>
        <a class="btn btn-blue" asp-action="ExportStockBalance" asp-route-keyword="@keyword" asp-route-groupId="@groupId" asp-route-stock="@stock">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
    </div>
</div>

<div class="card filter-bar mb-3 no-print">
    <div class="card-body">
        <form method="get" asp-action="StockBalance" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="keyword">Keyword</label>
                <input type="text" class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="รหัส / ชื่อสินค้า" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="groupId">Product Group</label>
                <select class="form-select" id="groupId" name="groupId">
                    <option value="">All</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g.Id" selected="@(groupId == g.Id)">@g.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="stock">Stock Status</label>
                <select class="form-select" id="stock" name="stock">
                    <option value="">All</option>
                    <option value="Normal" selected="@(stock == "Normal")">ปกติ</option>
                    <option value="Low" selected="@(stock == "Low")">ใกล้หมด</option>
                    <option value="Out" selected="@(stock == "Out")">หมด</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-search flex-grow-1"><i class="bi bi-search"></i> Search</button>
                <a class="btn btn-outline-dark-grey" asp-action="StockBalance" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="card stat-card"><div class="stat-icon grey"><i class="bi bi-box"></i></div><div><div class="stat-label">Items</div><div class="stat-value">@Model.Count</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card stat-card"><div class="stat-icon blue"><i class="bi bi-stack"></i></div><div><div class="stat-label">Total Qty</div><div class="stat-value">@Ui.Num(Model.Sum(r => r.Stock))</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card stat-card"><div class="stat-icon amber"><i class="bi bi-exclamation-triangle"></i></div><div><div class="stat-label">Low / Out</div><div class="stat-value">@Model.Count(r => r.State == StockState.Low) / @Model.Count(r => r.State == StockState.Out)</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card stat-card"><div class="stat-icon red"><i class="bi bi-cash-stack"></i></div><div><div class="stat-label">Stock Value</div><div class="stat-value fs-5">@Ui.Money(Model.Sum(r => r.Value))</div></div></div></div>
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-app table-hover">
            <thead>
                <tr><th>#</th><th>Code</th><th>Product Name</th><th>Group</th><th>UOM</th><th class="text-end">Stock Qty</th><th class="text-end">Reorder</th><th class="text-end">Unit Price</th><th class="text-end">Stock Value</th><th>Status</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var r = Model[i];
                    <tr>
                        <td class="text-muted">@(i + 1)</td>
                        <td><span class="code-pill">@r.Code</span></td>
                        <td class="fw-medium">@r.Name</td>
                        <td>@r.Group</td>
                        <td>@r.Uom</td>
                        <td class="text-end fw-semibold">@Ui.Num(r.Stock)</td>
                        <td class="text-end text-muted">@Ui.Num(r.Reorder)</td>
                        <td class="text-end">@Ui.Money(r.UnitPrice)</td>
                        <td class="text-end">@Ui.Money(r.Value)</td>
                        <td>@Ui.StockBadge(r.State)</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="empty-state"><i class="bi bi-inbox"></i>ไม่พบข้อมูล</td></tr>
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end">Total</td>
                        <td class="text-end">@Ui.Num(Model.Sum(r => r.Stock))</td>
                        <td colspan="2"></td>
                        <td class="text-end">@Ui.Money(Model.Sum(r => r.Value))</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

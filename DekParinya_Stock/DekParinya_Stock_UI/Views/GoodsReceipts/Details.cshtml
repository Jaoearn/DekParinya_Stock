@model GoodsReceipt
@{
    ViewData["Title"] = Model.DocNo;
    var remaining = Math.Max(0, ImageUploadService.MaxFiles - Model.Attachments.Count);
}

<div class="page-header">
    <div>
        <nav class="breadcrumb"><a asp-action="Index">Goods Receipt</a>&nbsp;/&nbsp;@Model.DocNo</nav>
        <h1 class="page-title">Goods Receipt Details</h1>
    </div>
</div>

<div class="form-card">
    <div class="card mb-3">
        <div class="card-body">
            <div class="doc-hero mb-3">
                <div>
                    <div class="text-muted small">Goods Receipt</div>
                    <div class="doc-no">@Model.DocNo</div>
                </div>
                <span class="badge-status status-approved">Received</span>
            </div>
            <h6 class="fw-semibold form-section-title">Receipt Information</h6>
            <div class="detail-grid">
                <div class="detail-item"><div class="label">Receive Date</div><div class="value">@Ui.Date(Model.ReceiveDate)</div></div>
                <div class="detail-item"><div class="label">Supplier</div><div class="value">@Model.Supplier</div></div>
                <div class="detail-item"><div class="label">Delivery Note No.</div><div class="value">@(Model.RefNo ?? "-")</div></div>
                <div class="detail-item"><div class="label">Vehicle No.</div><div class="value">@(Model.VehicleNo ?? "-")</div></div>
                <div class="detail-item"><div class="label">Received By</div><div class="value">@Model.ReceivedBy</div></div>
                <div class="detail-item"><div class="label">Created At</div><div class="value">@Ui.DateTime(Model.CreatedAt)</div></div>
                <div class="detail-item"><div class="label">Remark</div><div class="value">@(string.IsNullOrWhiteSpace(Model.Remark) ? "-" : Model.Remark)</div></div>
            </div>
        </div>
    </div>

    <div class="card table-card mb-3">
        <div class="card-header"><h2 class="card-title-sm">Materials <span class="text-muted fw-normal">(@Model.Lines.Count)</span></h2></div>
        <div class="table-responsive">
            <table class="table table-app">
                <thead><tr><th>#</th><th>Material</th><th class="text-end">Qty</th><th>Unit</th><th>Quality</th><th>Remark</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        var l = Model.Lines[i];
                        <tr>
                            <td class="text-muted">@(i + 1)</td>
                            <td class="fw-medium">@l.Material</td>
                            <td class="text-end fw-semibold">@Ui.Qty(l.Qty)</td>
                            <td>@l.Unit</td>
                            <td>
                                @if (l.Quality == "ดี") { <span class="badge-status status-approved">ดี</span> }
                                else if (l.Quality == "ต้องตรวจซ้ำ") { <span class="badge-status status-rejected">ต้องตรวจซ้ำ</span> }
                                else if (!string.IsNullOrEmpty(l.Quality)) { <span class="badge-status status-pending">@l.Quality</span> }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-muted">@(l.Remark ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title-sm"><i class="bi bi-images text-accent me-1"></i>Photos <span class="text-muted fw-normal">(@Model.Attachments.Count/@ImageUploadService.MaxFiles)</span></h2>
        </div>
        <div class="card-body">
            @if (Model.Attachments.Any())
            {
                <div class="gr-gallery">
                    @for (var i = 0; i < Model.Attachments.Count; i++)
                    {
                        var a = Model.Attachments[i];
                        <figure class="gr-photo">
                            <button type="button" class="gr-photo-open" data-lightbox-index="@i" aria-label="ดูรูป @a.FileName">
                                <img src="@a.Url" alt="@a.FileName" loading="lazy" />
                            </button>
                            <figcaption>
                                <span class="text-truncate" title="@a.FileName">@a.FileName</span>
                                <span class="text-muted">@ImageUploadService.FormatSize(a.Size)</span>
                            </figcaption>
                            <form asp-action="DeleteImage" asp-route-id="@Model.Id" method="post" class="gr-photo-del"
                                  data-confirm="ลบรูปนี้?" data-confirm-detail="@a.FileName" data-confirm-text="Delete">
                                <input type="hidden" name="attachmentId" value="@a.Id" />
                                <button type="submit" class="btn btn-icon btn-light" title="Delete"><i class="bi bi-trash text-danger"></i></button>
                            </form>
                        </figure>
                    }
                </div>
            }
            else
            {
                <div class="empty-state py-3"><i class="bi bi-image"></i>ยังไม่มีรูปแนบ</div>
            }

            @if (remaining > 0)
            {
                <form asp-action="AddImages" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mt-3">
                    <h6 class="fw-semibold form-section-title">Add Photos</h6>
                    <partial name="_ImageUploader" model="remaining" />
                    <div class="d-flex justify-content-end mt-2">
                        <button type="submit" class="btn btn-primary" data-upload-submit disabled><i class="bi bi-upload me-1"></i>Upload</button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="form-actions no-print">
        <a class="btn btn-outline-dark-grey" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back</a>
        <div class="actions-right">
            <button type="button" class="btn btn-outline-dark-grey" data-print><i class="bi bi-printer me-1"></i>Print</button>
        </div>
    </div>
</div>

<!-- Lightbox -->
<div class="modal fade" id="grLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content gr-lightbox">
            <div class="modal-header">
                <h5 class="modal-title fs-6" data-lb-title></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center position-relative">
                <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
                <img data-lb-img alt="" />
                <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Next"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="modal-footer justify-content-end">
                <span class="small text-muted me-auto" data-lb-count></span>
                <a class="btn btn-outline-dark-grey btn-sm" data-lb-download download><i class="bi bi-download me-1"></i>Download</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var photos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Attachments.Select(a => new { url = a.Url, name = a.FileName })));
            var modalEl = document.getElementById('grLightbox');
            if (!photos.length || !modalEl) return;
            var modal = new bootstrap.Modal(modalEl);
            var idx = 0;
            var img = modalEl.querySelector('[data-lb-img]');
            function show(i) {
                idx = (i + photos.length) % photos.length;
                img.src = photos[idx].url;
                img.alt = photos[idx].name;
                modalEl.querySelector('[data-lb-title]').textContent = photos[idx].name;
                modalEl.querySelector('[data-lb-count]').textContent = (idx + 1) + ' / ' + photos.length;
                var dl = modalEl.querySelector('[data-lb-download]');
                dl.href = photos[idx].url; dl.setAttribute('download', photos[idx].name);
                modalEl.querySelectorAll('.lb-nav').forEach(function (b) { b.hidden = photos.length < 2; });
            }
            document.querySelectorAll('[data-lightbox-index]').forEach(function (b) {
                b.addEventListener('click', function () { show(parseInt(b.dataset.lightboxIndex, 10)); modal.show(); });
            });
            modalEl.querySelector('[data-lb-prev]').addEventListener('click', function () { show(idx - 1); });
            modalEl.querySelector('[data-lb-next]').addEventListener('click', function () { show(idx + 1); });
            modalEl.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowLeft') show(idx - 1);
                if (e.key === 'ArrowRight') show(idx + 1);
            });
        })();
    </script>
}

@model List<GoodsReceipt>
@{
    ViewData["Title"] = "Goods Receipt";
    var keyword = ViewBag.Keyword as string;
    var material = ViewBag.Material as string;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
}

<div class="page-header">
    <div>
        <nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a>&nbsp;/&nbsp;Goods Receipt</nav>
        <h1 class="page-title">Goods Receipt (GR)</h1>
        <p class="page-subtitle">รับเข้าวัตถุดิบทำปุ๋ย — ดิน กาก ขุย มูลสัตว์ ฯลฯ พร้อมรูปถ่ายประกอบ</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add GR</a>
</div>

<div class="card filter-bar mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label" for="keyword">Keyword</label>
                <input type="text" class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="เลขที่ GR / ผู้ส่ง / เลขที่ใบส่งของ / ทะเบียนรถ" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label" for="material">Material</label>
                <select class="form-select" id="material" name="material">
                    <option value="">All</option>
                    @foreach (var g in RawMaterials.Groups)
                    {
                        <optgroup label="@g.Group">
                            @foreach (var m in g.Items)
                            {
                                <option value="@m" selected="@(material == m)">@m</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label" for="from">From</label>
                <input type="date" class="form-control" id="from" name="from" value="@Ui.Iso(from)" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label" for="to">To</label>
                <input type="date" class="form-control" id="to" name="to" value="@Ui.Iso(to)" />
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-search flex-grow-1"><i class="bi bi-search"></i> Search</button>
                <a class="btn btn-outline-dark-grey" asp-action="Index" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="card-header"><h2 class="card-title-sm">Receipts <span class="text-muted fw-normal">(@Model.Count)</span></h2></div>
    <div class="table-responsive">
        <table class="table table-app table-hover">
            <thead>
                <tr><th></th><th>GR No.</th><th>Receive Date</th><th>Supplier</th><th>Materials</th><th>Delivery Note</th><th>Received By</th><th class="text-center">Images</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var thumb = r.Attachments.FirstOrDefault();
                    <tr>
                        <td style="width:56px">
                            @if (thumb is not null)
                            {
                                <img src="@thumb.Url" alt="" class="gr-thumb-sm" loading="lazy" />
                            }
                            else
                            {
                                <span class="gr-thumb-sm gr-thumb-empty"><i class="bi bi-image"></i></span>
                            }
                        </td>
                        <td><a class="doc-link" asp-action="Details" asp-route-id="@r.Id">@r.DocNo</a></td>
                        <td>@Ui.Date(r.ReceiveDate)</td>
                        <td>@r.Supplier<div class="small text-muted">@(r.VehicleNo is null ? "" : "ทะเบียน " + r.VehicleNo)</div></td>
                        <td>
                            @foreach (var l in r.Lines.Take(3))
                            {
                                <span class="material-chip">@l.Material <b>@Ui.Qty(l.Qty)</b> @l.Unit</span>
                            }
                            @if (r.Lines.Count > 3) { <span class="small text-muted">+@(r.Lines.Count - 3)</span> }
                        </td>
                        <td class="text-muted">@(r.RefNo ?? "-")</td>
                        <td>@r.ReceivedBy</td>
                        <td class="text-center">
                            @if (r.Attachments.Any()) { <span class="badge-status status-normal"><i class="bi bi-images"></i>@r.Attachments.Count</span> }
                            else { <span class="text-muted">-</span> }
                        </td>
                        <td class="text-end"><a class="btn btn-outline-dark-grey btn-icon" asp-action="Details" asp-route-id="@r.Id" title="View"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="empty-state"><i class="bi bi-inbox"></i>ไม่พบข้อมูล</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

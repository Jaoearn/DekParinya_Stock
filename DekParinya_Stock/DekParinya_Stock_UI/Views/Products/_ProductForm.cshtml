@model Product
@inject IDataStore Store
@{
    var groups = Store.GetGroups();
    var vendors = Store.GetVendors();
}

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-section">
    <h6 class="fw-semibold form-section-title">Product Information</h6>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Code" class="form-label">Product Code <span class="req">*</span></label>
            <input asp-for="Code" class="form-control" required />
            <span asp-validation-for="Code" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Product Name <span class="req">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="ชื่อสินค้า" required />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="GroupId" class="form-label">Product Group <span class="req">*</span></label>
            <select asp-for="GroupId" class="form-select" required>
                <option value="">-- Select --</option>
                @foreach (var g in groups)
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </select>
            <span asp-validation-for="GroupId" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Vendor" class="form-label">Vendor</label>
            <input asp-for="Vendor" class="form-control" list="vendorList" placeholder="ผู้ขาย / ซัพพลายเออร์" />
            <datalist id="vendorList">
                @foreach (var v in vendors)
                {
                    <option value="@v"></option>
                }
            </datalist>
            <span asp-validation-for="Vendor" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Description" class="form-label">Description</label>
            <input asp-for="Description" class="form-control" placeholder="รายละเอียดเพิ่มเติม" />
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
    </div>
</div>

<div class="form-section">
    <h6 class="fw-semibold form-section-title">Stock &amp; Price</h6>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Uom" class="form-label">UOM <span class="req">*</span></label>
            <select asp-for="Uom" class="form-select" required>
                @foreach (var u in Lookups.Uoms)
                {
                    <option value="@u">@u</option>
                }
            </select>
            <span asp-validation-for="Uom" class="field-validation-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitPrice" class="form-label">Unit Price (฿) <span class="req">*</span></label>
            <input asp-for="UnitPrice" class="form-control text-end" type="number" step="0.01" min="0" required />
            <span asp-validation-for="UnitPrice" class="field-validation-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StockQty" class="form-label">Stock Qty <span class="req">*</span></label>
            <input asp-for="StockQty" class="form-control text-end" type="number" min="0" required />
            <span asp-validation-for="StockQty" class="field-validation-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ReorderLevel" class="form-label">Reorder Level <span class="req">*</span></label>
            <input asp-for="ReorderLevel" class="form-control text-end" type="number" min="0" required />
            <span asp-validation-for="ReorderLevel" class="field-validation-error"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        </div>
    </div>
</div>

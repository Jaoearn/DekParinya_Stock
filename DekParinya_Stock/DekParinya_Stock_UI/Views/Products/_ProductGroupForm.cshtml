@model ProductGroup

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-section">
    <h6 class="fw-semibold form-section-title">Group Information</h6>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Code" class="form-label">Group Code <span class="req">*</span></label>
            <input asp-for="Code" class="form-control" placeholder="เช่น GRP-BEV" required />
            <span asp-validation-for="Code" class="field-validation-error"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Group Name <span class="req">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="ชื่อกลุ่มสินค้า" required />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="รายละเอียดเพิ่มเติม"></textarea>
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        </div>
    </div>
</div>

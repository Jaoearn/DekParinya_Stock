@model List<StockAdjustment>
@{
    ViewData["Title"] = "Adjustment Approval";
    ViewData["Status"] = ViewBag.Status;
    ViewData["Counts"] = ViewBag.Counts;
    ViewData["Total"] = ViewBag.Total;
    ViewData["Keyword"] = ViewBag.Keyword;
    var keyword = ViewBag.Keyword as string;
    var status = ViewBag.Status as string;
}

<div class="page-header">
    <div>
        <nav class="breadcrumb"><a asp-controller="StockAdjustments" asp-action="Index">Stock Adjustment</a>&nbsp;/&nbsp;Approval</nav>
        <h1 class="page-title">Adjustment Approval</h1>
        <p class="page-subtitle">อนุมัติ / ไม่อนุมัติ ใบปรับปรุงสต๊อก</p>
    </div>
</div>

<partial name="_ApprovalTabs" view-data="ViewData" />

<div class="card filter-bar mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="status" value="@status" />
            <div class="col-md-9">
                <label class="form-label" for="keyword">Keyword</label>
                <input type="text" class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="เลขที่เอกสาร / ผู้ทำรายการ / เหตุผล" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-search flex-grow-1"><i class="bi bi-search"></i> Search</button>
                <a class="btn btn-outline-dark-grey" asp-action="Index" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-app table-hover">
            <thead>
                <tr><th>Doc No.</th><th>Adjust Date</th><th>Type</th><th>Reason</th><th>Requester</th><th class="text-end">Total Qty</th><th>Status</th><th class="text-end"></th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><a class="doc-link" asp-action="Details" asp-route-id="@a.Id">@a.DocNo</a></td>
                        <td>@Ui.Date(a.AdjustDate)</td>
                        <td>@Ui.AdjustTypeBadge(a.Type)</td>
                        <td>@a.Reason</td>
                        <td>@a.Requester</td>
                        <td class="text-end fw-semibold">@Ui.Num(a.TotalQty)</td>
                        <td>@Ui.StatusBadge(a.Status)</td>
                        <td class="text-end">
                            <a class="btn @(a.Status == DocStatus.Pending ? "btn-primary" : "btn-outline-dark-grey") btn-sm" asp-action="Details" asp-route-id="@a.Id">
                                @(a.Status == DocStatus.Pending ? "Review" : "View")
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="empty-state"><i class="bi bi-check2-all"></i>ไม่มีเอกสารในสถานะนี้</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

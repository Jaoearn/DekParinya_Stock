@inject IDataStore Store
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userName = User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "User") : "Guest";
    var userInitial = string.IsNullOrEmpty(userName) ? "U" : userName.Substring(0, 1).ToUpperInvariant();
    var pendingReq = Store.GetRequisitions().Count(r => r.Status == DocStatus.Pending);
    var pendingAdj = Store.GetAdjustments().Count(a => a.Status == DocStatus.Pending);

    var productsOpen = ctrl == "Products";
    var reqOpen = ctrl == "StockRequisitions" || ctrl == "StockRequisitionApproval";
    var adjOpen = ctrl == "StockAdjustments" || ctrl == "StockAdjustmentApproval";
    var reportOpen = ctrl == "Reports";
    var poOpen = ctrl == "PurchaseOrders" || ctrl == "ProductDemand";
}
@functions {
    string On(bool condition) => condition ? "active" : "";
}
<!DOCTYPE html>
<html lang="th" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Dashboard") · DekParinya Stock</title>
    <link rel="icon" href="~/logo/logo1.jpg" type="image/jpeg" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <!-- ===== Sidebar ===== -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-head">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-tile"><img src="~/logo/logo1.jpg" alt="ดินเด็กปริญญา" class="brand-logo-img" asp-append-version="true" /></span>
                    <span class="brand-text">
                        <span class="brand-logo">dekparinya</span>
                        <span class="brand-title">DAKPARINYA STOCK</span>
                    </span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-label">MAIN</div>
                <a class="nav-item-link @On(ctrl == "GoodsReceipts")" asp-controller="GoodsReceipts" asp-action="Index">
                    <i class="bi bi-box-arrow-in-down"></i><span>Goods Receipt (GR)</span>
                </a>
                <a class="nav-item-link @On(ctrl == "Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                </a>

                <!-- Products -->
                <button class="nav-item-link nav-toggle @(productsOpen ? "open" : "collapsed")" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navProducts" aria-expanded="@(productsOpen ? "true" : "false")">
                    <i class="bi bi-box-seam"></i><span>Products</span><i class="bi bi-chevron-down caret"></i>
                </button>
                <div class="collapse @(productsOpen ? "show" : "")" id="navProducts">
                    <div class="nav-sub">
                        <a class="nav-sub-link @On(ctrl == "Products" && act.Contains("Group"))" asp-controller="Products" asp-action="ProductGroup">Product Group</a>
                        <a class="nav-sub-link @On(ctrl == "Products" && act.Contains("ProductList"))" asp-controller="Products" asp-action="ProductList">Product List</a>
                    </div>
                </div>

                <!-- Stock Requisition -->
                <button class="nav-item-link nav-toggle @(reqOpen ? "open" : "collapsed")" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navReq" aria-expanded="@(reqOpen ? "true" : "false")">
                    <i class="bi bi-clipboard-check"></i><span>Stock Requisition</span><i class="bi bi-chevron-down caret"></i>
                </button>
                <div class="collapse @(reqOpen ? "show" : "")" id="navReq">
                    <div class="nav-sub">
                        <a class="nav-sub-link @On(ctrl == "StockRequisitions")" asp-controller="StockRequisitions" asp-action="Index">Requisition</a>
                        <a class="nav-sub-link @On(ctrl == "StockRequisitionApproval")" asp-controller="StockRequisitionApproval" asp-action="Index">
                            Approval
                            @if (pendingReq > 0) { <span class="nav-badge">@pendingReq</span> }
                        </a>
                    </div>
                </div>

                <!-- Purchase Order -->
                <a class="nav-item-link @On(poOpen)" asp-controller="PurchaseOrders" asp-action="Index">
                    <i class="bi bi-cart3"></i><span>Purchase Order</span>
                </a>

                <!-- Stock Adjustment -->
                <button class="nav-item-link nav-toggle @(adjOpen ? "open" : "collapsed")" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navAdj" aria-expanded="@(adjOpen ? "true" : "false")">
                    <i class="bi bi-sliders"></i><span>Stock Adjustment</span><i class="bi bi-chevron-down caret"></i>
                </button>
                <div class="collapse @(adjOpen ? "show" : "")" id="navAdj">
                    <div class="nav-sub">
                        <a class="nav-sub-link @On(ctrl == "StockAdjustments")" asp-controller="StockAdjustments" asp-action="Index">Adjustment</a>
                        <a class="nav-sub-link @On(ctrl == "StockAdjustmentApproval")" asp-controller="StockAdjustmentApproval" asp-action="Index">
                            Approval
                            @if (pendingAdj > 0) { <span class="nav-badge">@pendingAdj</span> }
                        </a>
                    </div>
                </div>

                <!-- Report -->
                <button class="nav-item-link nav-toggle @(reportOpen ? "open" : "collapsed")" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navReport" aria-expanded="@(reportOpen ? "true" : "false")">
                    <i class="bi bi-file-earmark-bar-graph"></i><span>Report</span><i class="bi bi-chevron-down caret"></i>
                </button>
                <div class="collapse @(reportOpen ? "show" : "")" id="navReport">
                    <div class="nav-sub">
                        <a class="nav-sub-link @On(ctrl == "Reports" && act == "StockBalance")" asp-controller="Reports" asp-action="StockBalance">Stock Balance</a>
                    </div>
                </div>
            </nav>

            <div class="sidebar-footer">
                <span>© @DateTime.Now.Year DekParinya</span>
                <span class="text-uppercase">UI Prototype</span>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <!-- ===== Main ===== -->
        <div class="main">
            <header class="topbar">
                <button class="icon-btn menu-toggle" type="button" data-sidebar-toggle aria-label="เปิด/หุบเมนู" title="เปิด/หุบเมนู (Ctrl+B)">
                    <i class="bi bi-list"></i>
                </button>

                <form class="global-search" action="/Search" method="get" role="search" autocomplete="off">
                    <i class="bi bi-search search-icon"></i>
                    <input type="search" name="q" id="globalSearch" class="form-control" placeholder="Search products, documents, users..."
                           value="@(ctrl == "Search" ? Context.Request.Query["q"].ToString() : "")" aria-label="Search" />
                    <kbd class="search-kbd">Ctrl K</kbd>
                    <div class="suggest-panel" id="suggestPanel" role="listbox"></div>
                </form>

                <div class="topbar-actions">
                    <button class="icon-btn" type="button" data-theme-toggle title="Toggle theme" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <div class="dropdown">
                        <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@userInitial</span>
                            <span class="d-none d-md-inline">@userName</span>
                            <i class="bi bi-chevron-down small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2"></i>Users</a></li>
                            <li><a class="dropdown-item" asp-controller="ProductDemand" asp-action="Index"><i class="bi bi-truck me-2"></i>Vendor Orders</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" data-confirm="ต้องการออกจากระบบหรือไม่?" data-confirm-text="Logout">
                                    <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="flash" hidden
         data-success="@TempData["Success"]"
         data-error="@TempData["Error"]"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

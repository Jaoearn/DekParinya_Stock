@model AppUser
@{
    ViewData["Title"] = "Add User";
}

<div class="page-header">
    <div>
        <nav class="breadcrumb"><a asp-action="Index">Users</a>&nbsp;/&nbsp;Add</nav>
        <h1 class="page-title">Add User</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="card form-card">
    <div class="card-body">
        <partial name="_UserForm" model="Model" />
        <div class="form-actions">
            <a class="btn btn-outline-dark-grey" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back</a>
            <div class="actions-right">
                <button type="submit" class="btn btn-primary" data-confirm="ยืนยันการเพิ่มผู้ใช้?" data-confirm-text="Save">
                    <i class="bi bi-check2 me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</form>
